<?xml version="1.0" encoding="utf-8"?>
<!--
    銀の細い枠の丸い手鏡。鏡面は上の水色から下の白へ移り、水色の上に白い光の筋とキラッをひとつずつ置く。
    虫眼鏡に見えないよう、鏡はまっすぐ立て、楕円の鏡に先の広がった短い柄を付ける。すべて中心 66dp の安全域に収める。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 柄 -->
    <path
        android:fillColor="#FF95A1AE"
        android:pathData="M50.5,63 H57.5 L59.2,79 A5.2,5.2 0 0 1 48.8,79 Z" />
    <path android:pathData="M51.25,63 H56.75 L58.5,79 A4.5,4.5 0 0 1 49.5,79 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="49.5"
                android:startY="0"
                android:endX="58.5"
                android:endY="0">
                <item android:offset="0" android:color="#FFC9D0D8" />
                <item android:offset="0.35" android:color="#FFF6F8FA" />
                <item android:offset="1" android:color="#FF8E9AA7" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 枠 -->
    <path
        android:fillColor="#FF95A1AE"
        android:pathData="M34.5,43.5 A19.5,21.5 0 1 0 73.5,43.5 A19.5,21.5 0 1 0 34.5,43.5 Z" />
    <path android:pathData="M35.2,43.5 A18.8,20.8 0 1 0 72.8,43.5 A18.8,20.8 0 1 0 35.2,43.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="25"
                android:endX="70"
                android:endY="62">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.45" android:color="#FFD3D9E0" />
                <item android:offset="1" android:color="#FF8C98A5" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FFA9B4BF"
        android:pathData="M37.8,43.5 A16.2,18.2 0 1 0 70.2,43.5 A16.2,18.2 0 1 0 37.8,43.5 Z" />
